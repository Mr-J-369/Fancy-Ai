    <string name="games_adventure_placeholder">Choose a path or write another move…</string>

    <string name="games_dice_title">Dice Duel RPG</string>
    <string name="games_dice_tagline">Roll, fight, survive.</string>
    <string name="games_dice_rules">Actions resolve through fair imagined dice rolls. The roll, outcome, and state of the battle stay visible in the story.</string>
    <string name="games_dice_placeholder">Make your next move…</string>

    <string name="games_tactical_title">Tactical Command</string>
    <string name="games_tactical_tagline">Outthink the opposing commander.</string>
    <string name="games_tactical_rules">Issue one command at a time in a concise strategy battle. Positions and consequences carry forward between turns.</string>
    <string name="games_tactical_placeholder">Issue a command…</string>

    <string name="games_truth_title">Truth or Dare</string>
    <string name="games_truth_tagline">Honesty or courage.</string>
    <string name="games_truth_rules">Choose truth or dare, answer one challenge, then turn the question back on your character.</string>
    <string name="games_truth_placeholder">Choose truth, dare, or answer the challenge…</string>

    <string name="games_two_truths_title">Two Truths &amp; a Lie</string>
    <string name="games_two_truths_tagline">Three claims. One deception.</string>
    <string name="games_two_truths_rules">Your character deals three numbered facts with one hidden lie. Commit to a number before the answer is revealed.</string>
    <string name="games_two_truths_placeholder">Which statement is the lie?</string>

    <string name="games_oracle_title">The Oracle</string>
    <string name="games_oracle_tagline">Ask, and the cards answer.</string>
    <string name="games_oracle_rules">Ask a question or request a card. Readings interpret the question without claiming guaranteed predictions.</string>
    <string name="games_oracle_placeholder">Ask the Oracle…</string>

    <string name="games_rather_title">Would You Rather</string>
    <string name="games_rather_tagline">Two impossible choices.</string>
    <string name="games_rather_rules">Choose between two difficult options. Your character reacts, shares their answer, and presents the next dilemma.</string>
    <string name="games_rather_placeholder">Choose one, or explain your answer…</string>

