<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- The HTTP route is generated only for validated loopback/private addresses. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">local.fancyai.invalid</domain>
    </domain-config>
</network-security-config>
