+    // hidden + gate * h. The fused op on backends that have it -- FLUX's, and the only form the
+    // HTP gets right here: its generic broadcast ADD of these chunk views renders black.
+    __STATIC_INLINE__ ggml_tensor* gated_residual(GGMLRunnerContext* ctx,
+                                                  ggml_tensor* hidden,
+                                                  ggml_tensor* h,
+                                                  ggml_tensor* gate) {
+        gate = ggml_reshape_3d(ctx->ggml_ctx, gate, gate->ne[0], 1, gate->ne[1]);  // [N, 1, C]
+        return Flux::gated_residual(ctx, hidden, h, gate);
+    }
